{{ 'section-brissa-insignia-carousel.css' | asset_url | stylesheet_tag }}

<section class="brissa-insignia">
  <div class="brissa-insignia__bg-blobs" aria-hidden="true">
    <span class="brissa-insignia__blob brissa-insignia__blob--1"> </span>
    <span class="brissa-insignia__blob brissa-insignia__blob--2"> </span>
    <span class="brissa-insignia__blob brissa-insignia__blob--3"> </span>
  </div>

  <div class="brissa-insignia__header reveal-base">
    {%- if section.settings.heading != blank -%}
      <h2 class="brissa-insignia__title">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <div class="brissa-editorial-line" aria-hidden="true"> </div>
  </div>

  {%- if section.blocks.size > 0 -%}
    <brissa-insignia-carousel class="brissa-insignia-carousel" id="BrissaInsignia-{{ section.id }}">
      <div class="brissa-insignia-carousel__track brissa-hide-scrollbar" data-brissa-carousel-track>
        {%- for block in section.blocks -%}
          {%- liquid
            assign product = block.settings.product
            assign position_class = 'brissa-insignia-card--' | append: block.settings.text_position
            assign card_image_alt = product.featured_image.alt | default: product.title | escape
          -%}
          <div class="brissa-insignia-card {{ position_class }}{% if block.settings.narrow %} brissa-insignia-card--narrow{% endif %} reveal-base" {{ block.shopify_attributes }}>
            <a href="{% if product %}{{ product.url }}{% else %}#{% endif %}" class="brissa-insignia-card__link">
              {%- if product.featured_image != blank -%}
                {{
                  product.featured_image
                  | image_url: width: 1200
                  | image_tag:
                    loading: 'lazy',
                    widths: '400,600,900,1200',
                    sizes: '90vw',
                    alt: card_image_alt
                }}
              {%- else -%}
                <img src="{{ block.settings.fallback_image_url }}" alt="{{ block.settings.title | escape }}" loading="lazy">
              {%- endif -%}

              <div class="brissa-insignia-card__scrim" aria-hidden="true"> </div>

              <div class="brissa-insignia-card__copy">
                {%- assign card_title = product.title | default: block.settings.title -%}
                {%- if card_title != blank -%}
                  <h3 class="brissa-insignia-card__title text-micro-shadow text-micro-shadow-title">
                    {{ card_title }}
                  </h3>
                {%- endif -%}
                {%- if block.settings.description_line_1 != blank -%}
                  <p class="brissa-insignia-card__desc text-micro-shadow text-micro-shadow-desc">{{ block.settings.description_line_1 }}</p>
                {%- endif -%}
                {%- if block.settings.description_line_2 != blank -%}
                  <p class="brissa-insignia-card__desc text-micro-shadow text-micro-shadow-desc">{{ block.settings.description_line_2 }}</p>
                {%- endif -%}
                <span class="brissa-insignia-card__cta text-micro-shadow">
                  {{ 'brissa.insignia.discover' | t }}
                  <span class="material-symbols-outlined" aria-hidden="true">trending_flat</span>
                </span>
              </div>
            </a>
          </div>
        {%- endfor -%}
      </div>

      <div class="brissa-insignia-carousel__dots" data-brissa-carousel-dots>
        {%- for block in section.blocks -%}
          <span class="brissa-insignia-carousel__dot{% if forloop.first %} is-active{% endif %}"> </span>
        {%- endfor -%}
      </div>
    </brissa-insignia-carousel>
  {%- endif -%}
</section>

{% javascript %}
  class BrissaInsigniaCarousel extends HTMLElement {
    connectedCallback() {
      this.track = this.querySelector('[data-brissa-carousel-track]');
      this.dots = Array.from(this.querySelectorAll('[data-brissa-carousel-dots] > *'));

      if (!this.track || !this.dots.length) return;

      this.track.addEventListener('scroll', () => this.onScroll(), { passive: true });
    }

    onScroll() {
      const scrollLeft = this.track.scrollLeft;
      const containerWidth = this.track.clientWidth;
      const centerPosition = scrollLeft + containerWidth / 2;

      let activeIndex = 0;
      let minDistance = Infinity;

      Array.from(this.track.children).forEach((child, index) => {
        const childCenter = child.offsetLeft + child.offsetWidth / 2;
        const distance = Math.abs(centerPosition - childCenter);

        if (distance < minDistance) {
          minDistance = distance;
          activeIndex = index;
        }
      });

      this.dots.forEach((dot, index) => {
        dot.classList.toggle('is-active', index === activeIndex);
      });
    }
  }

  customElements.define('brissa-insignia-carousel', BrissaInsigniaCarousel);
{% endjavascript %}

