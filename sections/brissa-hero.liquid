{{ 'section-brissa-hero.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign hero_bg_alt = section.settings.image.alt | default: section.settings.heading | escape
  assign hero_logo_alt = shop.name | escape
-%}

<brissa-hero class="brissa-hero" id="BrissaHero-{{ section.id }}">
  <div class="brissa-hero__bg" data-brissa-hero-bg>
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 1800
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          widths: '750,1000,1500,1800',
          sizes: '100vw',
          alt: hero_bg_alt
      }}
    {%- else -%}
      <img
        src="{{ 'brissa-hero-bg.png' | asset_url }}"
        alt="{{ section.settings.heading | escape }}"
        loading="eager"
      >
    {%- endif -%}
  </div>

  <div class="brissa-hero__scrim" aria-hidden="true"> </div>

  <div class="brissa-hero__content" data-brissa-hero-content>
    {%- if settings.logo != blank -%}
      {{ settings.logo | image_url: width: 400 | image_tag: loading: 'eager', alt: hero_logo_alt, class: 'brissa-hero__logo brissa-hero-fade-in', widths: '200,300,400' }}
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h1 class="brissa-hero__heading brissa-hero-fade-in">{{ section.settings.heading }}</h1>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="brissa-hero__text brissa-hero-fade-in">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <a
        {% if section.settings.button_link != blank %}href="{{ section.settings.button_link }}"{% else %}href="{{ routes.all_products_collection_url }}"{% endif %}
        class="brissa-hero__button brissa-hero-fade-in brissa-btn-interactive"
      >
        {{ section.settings.button_label }}
        <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
      </a>
    {%- endif -%}
  </div>

  <div class="brissa-hero__scroll-indicator" data-brissa-hero-scroll-indicator>
    <div class="brissa-hero__scroll-indicator-inner brissa-animate-float-down">
      <span class="brissa-hero__scroll-indicator-text">{{ section.settings.scroll_hint_text }}</span>
      <span class="material-symbols-outlined" aria-hidden="true">expand_more</span>
    </div>
  </div>
</brissa-hero>

{% javascript %}
  class BrissaHero extends HTMLElement {
    connectedCallback() {
      this.bg = this.querySelector('[data-brissa-hero-bg]');
      this.content = this.querySelector('[data-brissa-hero-content]');
      this.scrollIndicator = this.querySelector('[data-brissa-hero-scroll-indicator]');
      this.ticking = false;

      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        return;
      }

      window.addEventListener('scroll', () => this.onScroll(), { passive: true });
    }

    onScroll() {
      if (this.ticking) return;
      this.ticking = true;

      requestAnimationFrame(() => {
        const scrollY = window.scrollY;
        const windowHeight = window.innerHeight;

        if (scrollY < windowHeight * 1.5) {
          this.bg.style.transform = `translateY(${scrollY * 0.25}px)`;

          const opacity = Math.max(0, 1 - scrollY / (windowHeight * 0.5));
          this.content.style.opacity = String(opacity);
          this.content.style.transform = `translateY(${scrollY * 0.15}px)`;

          this.scrollIndicator.style.opacity = String(Math.max(0, 1 - scrollY / (windowHeight * 0.2)));
        }

        this.ticking = false;
      });
    }
  }

  customElements.define('brissa-hero', BrissaHero);
{% endjavascript %}

{% schema %}
{
  "name": "Brissa hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "Elixires para el alma",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "default": "<p>Velas que transforman espacios,<br>despiertan sentidos<br>y guardan una intención.</p>",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "Explorar Colección",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "scroll_hint_text",
      "default": "Desliza para descubrir",
      "label": "Scroll hint text"
    }
  ],
  "presets": [
    {
      "name": "Brissa hero"
    }
  ]
}
{% endschema %}
