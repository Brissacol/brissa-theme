{{ 'section-hero-intro.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign scheme_from = settings.color_schemes['scheme-3']
  assign scheme_to = settings.color_schemes['scheme-1']
-%}

<hero-intro-scroll
  class="hero-intro pattern-mosaic"
  id="HeroIntro-{{ section.id }}"
  style="
    --hero-intro-from: {{ scheme_from.settings.background.red }},{{ scheme_from.settings.background.green }},{{ scheme_from.settings.background.blue }};
    --hero-intro-to: {{ scheme_to.settings.background.red }},{{ scheme_to.settings.background.green }},{{ scheme_to.settings.background.blue }};
    --hero-intro-text: {{ scheme_from.settings.text.red }},{{ scheme_from.settings.text.green }},{{ scheme_from.settings.text.blue }};
    --hero-intro-gold: {{ scheme_from.settings.button.red }},{{ scheme_from.settings.button.green }},{{ scheme_from.settings.button.blue }};
  "
>
  <div class="hero-intro__bg-layer hero-intro__bg-layer--from"></div>
  <div class="hero-intro__bg-layer hero-intro__bg-layer--to" data-hero-intro-bg-to></div>

  <div class="hero-intro__sticky">
    <div class="hero-intro__content">
      {%- if settings.logo != blank -%}
        {%- assign logo_alt = settings.logo.alt | default: shop.name | escape -%}
        <div class="hero-intro__logo hero-intro__logo--image" data-hero-intro-wordmark>
          {{
            settings.logo
            | image_url: width: 600
            | image_tag:
              loading: 'eager',
              widths: '200,300,400,600',
              alt: logo_alt,
              sizes: '(min-width: 750px) 26rem, 60vw'
          }}
        </div>
      {%- else -%}
        <p class="hero-intro__logo hero-intro__logo--text" data-hero-intro-wordmark>{{ shop.name }}</p>
      {%- endif -%}

      <p class="hero-intro__tagline" data-hero-intro-tagline>{{ 'general.intro_animation.tagline' | t }}</p>

      <div class="hero-intro__scroll-hint" data-hero-intro-scroll-hint>
        <span class="hero-intro__scroll-hint-text">{{ 'general.intro_animation.scroll_hint' | t }}</span>
        <svg class="hero-intro__scroll-hint-arrow" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
          <path d="M8 13V3M3.5 7.5L8 3l4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
    </div>
  </div>
</hero-intro-scroll>

{% javascript %}
  class HeroIntroScroll extends HTMLElement {
    connectedCallback() {
      this.logo = this.querySelector('[data-hero-intro-wordmark]');
      this.bgTo = this.querySelector('[data-hero-intro-bg-to]');
      this.tagline = this.querySelector('[data-hero-intro-tagline]');
      this.scrollHint = this.querySelector('[data-hero-intro-scroll-hint]');
      this.ticking = false;

      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        this.bgTo.style.opacity = '1';
        this.logo.classList.add('hero-intro__logo--visible');
        this.tagline.classList.add('hero-intro__tagline--visible');
        this.scrollHint.classList.add('hero-intro__scroll-hint--visible');
        return;
      }

      this.measure();

      this.onScrollHandler = this.onScroll.bind(this);
      this.onResizeHandler = this.onResize.bind(this);
      window.addEventListener('scroll', this.onScrollHandler, { passive: true });
      window.addEventListener('resize', this.onResizeHandler);

      if (window.visualViewport) {
        window.visualViewport.addEventListener('resize', this.onResizeHandler);
      }

      this.updateProgress();

      requestAnimationFrame(() => this.logo.classList.add('hero-intro__logo--visible'));
      window.setTimeout(() => this.tagline.classList.add('hero-intro__tagline--visible'), 500);
      window.setTimeout(() => this.scrollHint.classList.add('hero-intro__scroll-hint--visible'), 900);
    }

    disconnectedCallback() {
      window.removeEventListener('scroll', this.onScrollHandler);
      window.removeEventListener('resize', this.onResizeHandler);

      if (window.visualViewport) {
        window.visualViewport.removeEventListener('resize', this.onResizeHandler);
      }
    }

    measure() {
      this.scrollBudget = window.innerHeight * 0.6;
    }

    onResize() {
      this.measure();
      this.onScroll();
    }

    onScroll() {
      if (this.ticking) return;
      this.ticking = true;

      requestAnimationFrame(() => {
        this.updateProgress();
        this.ticking = false;
      });
    }

    remap(value, start, end) {
      if (end === start) return value >= end ? 1 : 0;
      return Math.min(1, Math.max(0, (value - start) / (end - start)));
    }

    smoothstep(t) {
      return t * t * (3 - 2 * t);
    }

    updateProgress() {
      const scrollY = window.scrollY || document.documentElement.scrollTop || 0;
      const budget = this.scrollBudget || window.innerHeight * 0.6;
      const progress = Math.min(1, Math.max(0, scrollY / budget));

      try {
        sessionStorage.setItem('brissaHeroScrollY', String(scrollY));
      } catch (e) {}

      this.updateBackground(progress);
      this.updateFade(progress);
    }

    updateBackground(progress) {
      this.bgTo.style.opacity = String(this.smoothstep(progress));
    }

    updateFade(progress) {
      if (progress > 0.001) {
        if (!this.faded) {
          this.faded = true;
          this.logo.style.transition = 'none';
          this.tagline.style.transition = 'none';
          this.scrollHint.style.transition = 'none';
        }

        const eased = this.smoothstep(progress);
        const opacity = String(1 - eased);
        this.logo.style.opacity = opacity;
        this.tagline.style.opacity = opacity;
        this.scrollHint.style.opacity = opacity;
      } else if (this.faded) {
        this.faded = false;
        this.logo.style.transition = '';
        this.tagline.style.transition = '';
        this.scrollHint.style.transition = '';
        this.logo.style.opacity = '';
        this.tagline.style.opacity = '';
        this.scrollHint.style.opacity = '';
      }
    }
  }

  customElements.define('hero-intro-scroll', HeroIntroScroll);
{% endjavascript %}

{% schema %}
{
  "name": "Hero intro",
  "settings": [],
  "presets": [
    {
      "name": "Hero intro"
    }
  ]
}
{% endschema %}
