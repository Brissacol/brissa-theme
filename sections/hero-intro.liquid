{{ 'section-hero-intro.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign scheme_from = settings.color_schemes['scheme-3']
  assign scheme_to = settings.color_schemes['scheme-1']
-%}

<hero-intro-scroll
  class="hero-intro pattern-mosaic"
  id="HeroIntro-{{ section.id }}"
  style="
    --hero-intro-from: {{ scheme_from.settings.background.red }},{{ scheme_from.settings.background.green }},{{ scheme_from.settings.background.blue }};
    --hero-intro-to: {{ scheme_to.settings.background.red }},{{ scheme_to.settings.background.green }},{{ scheme_to.settings.background.blue }};
    --hero-intro-text: {{ scheme_from.settings.text.red }},{{ scheme_from.settings.text.green }},{{ scheme_from.settings.text.blue }};
    --hero-intro-gold: {{ scheme_from.settings.button.red }},{{ scheme_from.settings.button.green }},{{ scheme_from.settings.button.blue }};
  "
>
  <div class="hero-intro__bg-layer hero-intro__bg-layer--from"></div>
  <div class="hero-intro__bg-layer hero-intro__bg-layer--to" data-hero-intro-bg-to></div>

  <div class="hero-intro__sticky">
    <div class="hero-intro__content">
      {%- if settings.logo != blank -%}
        {%- assign logo_alt = settings.logo.alt | default: shop.name | escape -%}
        <div class="hero-intro__logo hero-intro__logo--image" data-hero-intro-wordmark>
          {{
            settings.logo
            | image_url: width: 600
            | image_tag:
              loading: 'eager',
              widths: '200,300,400,600',
              alt: logo_alt,
              sizes: '(min-width: 750px) 26rem, 60vw'
          }}
        </div>
      {%- else -%}
        <p class="hero-intro__logo hero-intro__logo--text" data-hero-intro-wordmark>{{ shop.name }}</p>
      {%- endif -%}

      <p class="hero-intro__tagline" data-hero-intro-tagline>{{ 'general.intro_animation.tagline' | t }}</p>

      <div class="hero-intro__scroll-hint" data-hero-intro-scroll-hint>
        <span class="hero-intro__scroll-hint-text">{{ 'general.intro_animation.scroll_hint' | t }}</span>
        <svg class="hero-intro__scroll-hint-arrow" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
          <path d="M8 13V3M3.5 7.5L8 3l4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
    </div>

    <div class="hero-intro__frames" data-hero-intro-frames>
      <img class="hero-intro__frames-bg" src="{{ 'fondo celular.jpg' | asset_url }}" alt="" loading="lazy">

      {%- for i in (1..10) -%}
        {%- assign frame_number = i | prepend: '00' | slice: -2, 2 -%}
        <img
          class="hero-intro__frame"
          data-hero-intro-frame
          src="{{ 'Frame ' | append: frame_number | append: '.jpg' | asset_url }}"
          alt=""
          loading="lazy"
          width="1080"
          height="1350"
        >
      {%- endfor -%}

      <a
        href="{{ routes.all_products_collection_url }}"
        class="hero-intro__frame-button"
        data-hero-intro-frame-button
        aria-label="{{ 'general.intro_animation.choose_button' | t }}"
      >
        <img src="{{ 'elegir.png' | asset_url }}" alt="" loading="lazy" width="2000" height="2000">
      </a>
    </div>
  </div>
</hero-intro-scroll>

{% javascript %}
  class HeroIntroScroll extends HTMLElement {
    connectedCallback() {
      this.logo = this.querySelector('[data-hero-intro-wordmark]');
      this.bgTo = this.querySelector('[data-hero-intro-bg-to]');
      this.tagline = this.querySelector('[data-hero-intro-tagline]');
      this.scrollHint = this.querySelector('[data-hero-intro-scroll-hint]');
      this.framesContainer = this.querySelector('[data-hero-intro-frames]');
      this.frames = Array.from(this.querySelectorAll('[data-hero-intro-frame]'));
      this.frameButton = this.querySelector('[data-hero-intro-frame-button]');
      this.ticking = false;

      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        this.bgTo.style.opacity = '1';
        this.logo.classList.add('hero-intro__logo--visible');
        this.tagline.classList.add('hero-intro__tagline--visible');
        this.scrollHint.classList.add('hero-intro__scroll-hint--visible');

        if (this.framesContainer && window.matchMedia('(max-width: 749px)').matches) {
          this.logo.style.display = 'none';
          this.tagline.style.display = 'none';
          this.scrollHint.style.display = 'none';
          this.framesContainer.style.opacity = '1';
          this.frames.forEach((frame) => (frame.style.opacity = '1'));
          if (this.frameButton) {
            this.frameButton.style.opacity = '1';
            this.frameButton.style.pointerEvents = 'auto';
          }
        }

        return;
      }

      this.measure();

      this.onScrollHandler = this.onScroll.bind(this);
      this.onResizeHandler = this.onResize.bind(this);
      window.addEventListener('scroll', this.onScrollHandler, { passive: true });
      window.addEventListener('resize', this.onResizeHandler);

      if (window.visualViewport) {
        window.visualViewport.addEventListener('resize', this.onResizeHandler);
      }

      this.updateProgress();

      requestAnimationFrame(() => this.logo.classList.add('hero-intro__logo--visible'));
      window.setTimeout(() => this.tagline.classList.add('hero-intro__tagline--visible'), 500);
      window.setTimeout(() => this.scrollHint.classList.add('hero-intro__scroll-hint--visible'), 900);
    }

    disconnectedCallback() {
      window.removeEventListener('scroll', this.onScrollHandler);
      window.removeEventListener('resize', this.onResizeHandler);

      if (window.visualViewport) {
        window.visualViewport.removeEventListener('resize', this.onResizeHandler);
      }
    }

    measure() {
      this.scrollBudget = window.innerHeight * 0.6;
      this.framesScrollDistance = window.innerHeight * 3.4;
      this.isMobile = window.matchMedia('(max-width: 749px)').matches;
      this.measureFrameButton();
    }

    measureFrameButton() {
      if (!this.framesContainer || !this.frameButton) return;

      const containerRect = this.framesContainer.getBoundingClientRect();
      if (containerRect.width === 0 || containerRect.height === 0) return;

      const imageWidth = 1080;
      const imageHeight = 1350;
      const scale = Math.min(containerRect.width / imageWidth, containerRect.height / imageHeight);
      const displayedWidth = imageWidth * scale;
      const displayedHeight = imageHeight * scale;
      const offsetX = (containerRect.width - displayedWidth) / 2;
      const offsetY = (containerRect.height - displayedHeight) / 2;

      const left = offsetX + 0.284 * displayedWidth;
      const right = offsetX + 0.716 * displayedWidth;
      const top = offsetY + 0.764 * displayedHeight;
      const bottom = offsetY + 0.835 * displayedHeight;

      this.frameButton.style.left = `${left}px`;
      this.frameButton.style.width = `${right - left}px`;
      this.frameButton.style.top = `${top}px`;
      this.frameButton.style.height = `${bottom - top}px`;
    }

    onResize() {
      this.measure();
      this.onScroll();
    }

    onScroll() {
      if (this.ticking) return;
      this.ticking = true;

      requestAnimationFrame(() => {
        this.updateProgress();
        this.ticking = false;
      });
    }

    remap(value, start, end) {
      if (end === start) return value >= end ? 1 : 0;
      return Math.min(1, Math.max(0, (value - start) / (end - start)));
    }

    smoothstep(t) {
      return t * t * (3 - 2 * t);
    }

    updateProgress() {
      const scrollY = window.scrollY || document.documentElement.scrollTop || 0;
      const budget = this.scrollBudget || window.innerHeight * 0.6;
      const progress = Math.min(1, Math.max(0, scrollY / budget));

      this.updateBackground(progress);
      this.updateFade(progress);

      if (this.isMobile && this.framesContainer && this.frames.length > 1) {
        this.updateFrames(scrollY, budget);
      }
    }

    updateBackground(progress) {
      this.bgTo.style.opacity = String(this.smoothstep(progress));
    }

    updateFade(progress) {
      const fadeOutEnd = 0.6;

      if (progress > 0.001) {
        if (!this.faded) {
          this.faded = true;
          this.logo.style.transition = 'none';
          this.tagline.style.transition = 'none';
          this.scrollHint.style.transition = 'none';
        }

        const eased = this.smoothstep(this.remap(progress, 0, fadeOutEnd));
        const opacity = String(1 - eased);
        this.logo.style.opacity = opacity;
        this.tagline.style.opacity = opacity;
        this.scrollHint.style.opacity = opacity;
      } else if (this.faded) {
        this.faded = false;
        this.logo.style.transition = '';
        this.tagline.style.transition = '';
        this.scrollHint.style.transition = '';
        this.logo.style.opacity = '';
        this.tagline.style.opacity = '';
        this.scrollHint.style.opacity = '';
      }
    }

    updateFrames(scrollY, budget) {
      const showFrames = scrollY >= budget;
      this.framesContainer.style.opacity = showFrames ? '1' : '0';

      if (!showFrames) return;

      const distance = this.framesScrollDistance || window.innerHeight * 3.4;
      const framesProgress = this.remap(scrollY, budget, budget + distance);
      const transitions = this.frames.length - 1;
      if (transitions <= 0) return;

      const halfWidth = 0.05;

      for (let i = 1; i < this.frames.length; i += 1) {
        const center = i / transitions;
        const opacity = this.smoothstep(this.remap(framesProgress, center - halfWidth, center + halfWidth));
        this.frames[i].style.opacity = String(opacity);

        if (i === this.frames.length - 1 && this.frameButton) {
          this.frameButton.style.opacity = String(opacity);
          this.frameButton.style.pointerEvents = opacity > 0.9 ? 'auto' : 'none';
        }
      }
    }
  }

  customElements.define('hero-intro-scroll', HeroIntroScroll);
{% endjavascript %}

{% schema %}
{
  "name": "Hero intro",
  "settings": [],
  "presets": [
    {
      "name": "Hero intro"
    }
  ]
}
{% endschema %}
