{{ 'section-hero-intro.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign scheme_from = settings.color_schemes['scheme-3']
  assign scheme_to = settings.color_schemes['scheme-1']
-%}

<hero-intro-scroll
  class="hero-intro pattern-mosaic"
  id="HeroIntro-{{ section.id }}"
  style="
    --hero-intro-from: {{ scheme_from.settings.background.red }},{{ scheme_from.settings.background.green }},{{ scheme_from.settings.background.blue }};
    --hero-intro-to: {{ scheme_to.settings.background.red }},{{ scheme_to.settings.background.green }},{{ scheme_to.settings.background.blue }};
    --hero-intro-text: {{ scheme_from.settings.text.red }},{{ scheme_from.settings.text.green }},{{ scheme_from.settings.text.blue }};
    --hero-intro-gold: {{ scheme_from.settings.button.red }},{{ scheme_from.settings.button.green }},{{ scheme_from.settings.button.blue }};
  "
>
  <div class="hero-intro__sticky">
    <div class="hero-intro__content">
      <div class="hero-intro__logo hero-intro__wordmark" data-hero-intro-wordmark>
        <span class="hero-intro__letter" data-hero-intro-letter-b>B</span><span class="hero-intro__letter" data-hero-intro-letter-rest>R</span><span class="hero-intro__letter" data-hero-intro-letter-rest>I</span><span class="hero-intro__letter" data-hero-intro-letter-rest>S</span><span class="hero-intro__letter" data-hero-intro-letter-rest>S</span><span class="hero-intro__letter" data-hero-intro-letter-rest>A</span>
        <svg class="hero-intro__star" data-hero-intro-star viewBox="-12 -12 24 24" aria-hidden="true" focusable="false">
          <path d="M0,-10 Q0,0 10,0 Q0,0 0,10 Q0,0 -10,0 Q0,0 0,-10 Z"/>
        </svg>
      </div>

      <p class="hero-intro__tagline" data-hero-intro-tagline>{{ 'general.intro_animation.tagline' | t }}</p>
    </div>

    <div class="hero-intro__narrative" data-hero-intro-narrative>
      <div class="hero-intro__glow" data-hero-intro-glow aria-hidden="true"></div>

      <div class="hero-intro__narrative-inner">
        <div class="hero-intro__icon-stack" aria-hidden="true">
          <svg class="hero-intro__icon" data-hero-intro-icon="flame" viewBox="0 0 24 24" focusable="false">
            <path d="M12 3C9 8 7 11.5 7 14.5C7 17.5 9.5 20 12 20C14.5 20 17 17.5 17 14.5C17 11.5 15 8 12 3Z"/>
          </svg>
          <svg class="hero-intro__icon" data-hero-intro-icon="constellation" viewBox="0 0 24 24" focusable="false">
            <path d="M4 18L9 9L14 13L20 6"/>
            <circle cx="4" cy="18" r="1.2"/>
            <circle cx="9" cy="9" r="1.2"/>
            <circle cx="14" cy="13" r="1.2"/>
            <circle cx="20" cy="6" r="1.2"/>
          </svg>
          <svg class="hero-intro__icon" data-hero-intro-icon="fusion" viewBox="0 0 24 24" focusable="false">
            <path d="M10 7C8 10 7 12.5 7 14.3C7 16.6 8.6 18.3 10.7 18.3C12.8 18.3 14.3 16.6 14.3 14.3C14.3 12.5 13.3 10 10 7Z"/>
            <path d="M17.5,3.8 Q17.5,7 20.7,7 Q17.5,7 17.5,10.2 Q17.5,7 14.3,7 Q17.5,7 17.5,3.8 Z"/>
          </svg>
        </div>

        <div class="hero-intro__fragment-stage">
          {%- for i in (1..7) -%}
            {%- assign fragment_key = 'general.hero_narrative.fragment_' | append: i -%}
            <p class="hero-intro__fragment" data-hero-intro-fragment="{{ forloop.index0 }}">{{ fragment_key | t }}</p>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</hero-intro-scroll>

{% javascript %}
  class HeroIntroScroll extends HTMLElement {
    connectedCallback() {
      this.sticky = this.querySelector('.hero-intro__sticky');
      this.wordmark = this.querySelector('[data-hero-intro-wordmark]');
      this.bLetter = this.querySelector('[data-hero-intro-letter-b]');
      this.restLetters = Array.from(this.querySelectorAll('[data-hero-intro-letter-rest]'));
      this.star = this.querySelector('[data-hero-intro-star]');
      this.tagline = this.querySelector('[data-hero-intro-tagline]');
      this.narrative = this.querySelector('[data-hero-intro-narrative]');
      this.icons = {
        flame: this.querySelector('[data-hero-intro-icon="flame"]'),
        constellation: this.querySelector('[data-hero-intro-icon="constellation"]'),
        fusion: this.querySelector('[data-hero-intro-icon="fusion"]'),
      };
      this.fragments = Array.from(this.querySelectorAll('[data-hero-intro-fragment]'));

      this.fromColor = this.readColor('--hero-intro-from');
      this.toColor = this.readColor('--hero-intro-to');
      this.ticking = false;

      this.phases = {
        bg: [0, 0.1],
        converge: [0.1, 0.16],
        flash: [0.16, 0.2],
        toCorner: [0.2, 0.26],
        narrative: [0.26, 1],
      };

      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        this.style.backgroundColor = `rgb(${this.toColor.join(',')})`;
        this.wordmark.classList.add('hero-intro__logo--visible');
        this.tagline.classList.add('hero-intro__tagline--visible');
        return;
      }

      this.measure();

      this.onScrollHandler = this.onScroll.bind(this);
      this.onResizeHandler = this.onResize.bind(this);
      window.addEventListener('scroll', this.onScrollHandler, { passive: true });
      window.addEventListener('resize', this.onResizeHandler);

      if (window.visualViewport) {
        window.visualViewport.addEventListener('resize', this.onResizeHandler);
      }

      this.updateProgress();

      requestAnimationFrame(() => this.wordmark.classList.add('hero-intro__logo--visible'));
      window.setTimeout(() => this.tagline.classList.add('hero-intro__tagline--visible'), 500);
    }

    disconnectedCallback() {
      window.removeEventListener('scroll', this.onScrollHandler);
      window.removeEventListener('resize', this.onResizeHandler);

      if (window.visualViewport) {
        window.visualViewport.removeEventListener('resize', this.onResizeHandler);
      }
    }

    readColor(propertyName) {
      return getComputedStyle(this)
        .getPropertyValue(propertyName)
        .split(',')
        .map((value) => parseInt(value.trim(), 10));
    }

    measure() {
      const bRect = this.bLetter.getBoundingClientRect();
      const bCenterX = bRect.left + bRect.width / 2;

      this.letterOffsets = this.restLetters.map((el) => {
        const rect = el.getBoundingClientRect();
        const centerX = rect.left + rect.width / 2;
        return centerX - bCenterX;
      });

      const wordmarkRect = this.wordmark.getBoundingClientRect();
      const stickyRect = this.sticky.getBoundingClientRect();
      const wordmarkCenterX = wordmarkRect.left + wordmarkRect.width / 2;
      const wordmarkCenterY = wordmarkRect.top + wordmarkRect.height / 2;

      this.cornerScale = 0.32;
      const padding = 28;
      const targetCenterX = stickyRect.left + padding + (wordmarkRect.width * this.cornerScale) / 2;
      const targetCenterY = stickyRect.top + padding + (wordmarkRect.height * this.cornerScale) / 2;

      this.cornerTranslateX = targetCenterX - wordmarkCenterX;
      this.cornerTranslateY = targetCenterY - wordmarkCenterY;
    }

    onResize() {
      this.measure();
      this.onScroll();
    }

    onScroll() {
      if (this.ticking) return;
      this.ticking = true;

      requestAnimationFrame(() => {
        this.updateProgress();
        this.ticking = false;
      });
    }

    remap(value, start, end) {
      if (end === start) return value >= end ? 1 : 0;
      return Math.min(1, Math.max(0, (value - start) / (end - start)));
    }

    smoothstep(t) {
      return t * t * (3 - 2 * t);
    }

    phaseProgress(progress, phase) {
      return this.smoothstep(this.remap(progress, phase[0], phase[1]));
    }

    updateProgress() {
      const rect = this.getBoundingClientRect();
      const scrollDistance = this.offsetHeight - window.innerHeight;
      const rawProgress = scrollDistance > 0 ? -rect.top / scrollDistance : 0;
      const progress = Math.min(1, Math.max(0, rawProgress));

      this.updateBackground(progress);
      this.updateTagline(progress);
      this.updateConvergence(progress);
      this.updateStar(progress);
      this.updateCorner(progress);
      this.updateNarrative(progress);
    }

    updateBackground(progress) {
      const eased = this.phaseProgress(progress, this.phases.bg);

      const r = Math.round(this.fromColor[0] + (this.toColor[0] - this.fromColor[0]) * eased);
      const g = Math.round(this.fromColor[1] + (this.toColor[1] - this.fromColor[1]) * eased);
      const b = Math.round(this.fromColor[2] + (this.toColor[2] - this.fromColor[2]) * eased);

      this.style.backgroundColor = `rgb(${r}, ${g}, ${b})`;
    }

    updateTagline(progress) {
      const [start, end] = this.phases.bg;
      const fadeOutEnd = start + (end - start) * 0.5;

      if (progress > 0.001) {
        if (!this.taglineManual) {
          this.taglineManual = true;
          this.tagline.style.transition = 'none';
        }

        const fadeEased = this.smoothstep(this.remap(progress, start, fadeOutEnd));
        this.tagline.style.opacity = String(1 - fadeEased);
      } else if (this.taglineManual) {
        this.taglineManual = false;
        this.tagline.style.transition = '';
        this.tagline.style.opacity = '';
      }
    }

    updateConvergence(progress) {
      const eased = this.phaseProgress(progress, this.phases.converge);

      this.restLetters.forEach((el, index) => {
        const offset = this.letterOffsets[index] || 0;
        el.style.opacity = String(1 - eased);
        el.style.transform = `translateX(${-offset * eased}px)`;
      });
    }

    updateStar(progress) {
      const [start, end] = this.phases.flash;
      const local = this.remap(progress, start, end);
      let opacity;

      if (local <= 0.5) {
        opacity = this.smoothstep(local * 2);
      } else {
        opacity = 1 - this.smoothstep((local - 0.5) * 2);
      }

      this.star.style.opacity = String(opacity);
    }

    updateCorner(progress) {
      const eased = this.phaseProgress(progress, this.phases.toCorner);
      const scale = 1 + (this.cornerScale - 1) * eased;
      const x = this.cornerTranslateX * eased;
      const y = this.cornerTranslateY * eased;

      this.wordmark.style.transform = `translate(${x}px, ${y}px) scale(${scale})`;
    }

    updateNarrative(progress) {
      const [narrativeStart, narrativeEnd] = this.phases.narrative;
      const containerOpacity = this.smoothstep(
        this.remap(progress, this.phases.toCorner[1] - 0.02, this.phases.toCorner[1] + 0.01)
      );
      this.narrative.style.opacity = String(containerOpacity);

      const fragmentCount = this.fragments.length;
      if (fragmentCount === 0) return;

      const step = (narrativeEnd - narrativeStart) / fragmentCount;

      this.fragments.forEach((fragment, index) => {
        const center = narrativeStart + step * (index + 0.5);
        const distance = Math.abs(progress - center) / step;
        const isLast = index === fragmentCount - 1;

        let opacity;
        if (isLast && progress > center) {
          opacity = 1;
        } else if (distance <= 0.35) {
          opacity = 1;
        } else if (distance >= 0.65) {
          opacity = 0;
        } else {
          const t = (distance - 0.35) / 0.3;
          opacity = 1 - this.smoothstep(t);
        }

        fragment.style.opacity = String(opacity);
      });

      const boundary23 = narrativeStart + step * 3;
      const boundary56 = narrativeStart + step * 6;
      const transitionWidth = step * 0.6;

      const crossfade23 = this.smoothstep(
        this.remap(progress, boundary23 - transitionWidth / 2, boundary23 + transitionWidth / 2)
      );
      const crossfade56 = this.smoothstep(
        this.remap(progress, boundary56 - transitionWidth / 2, boundary56 + transitionWidth / 2)
      );

      this.icons.flame.style.opacity = String(1 - crossfade23);
      this.icons.constellation.style.opacity = String(crossfade23 * (1 - crossfade56));
      this.icons.fusion.style.opacity = String(crossfade56);
    }
  }

  customElements.define('hero-intro-scroll', HeroIntroScroll);
{% endjavascript %}

{% schema %}
{
  "name": "Hero intro",
  "settings": [],
  "presets": [
    {
      "name": "Hero intro"
    }
  ]
}
{% endschema %}
