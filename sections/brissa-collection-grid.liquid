{{ 'section-brissa-collection-grid.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign tag_colors = 'lavender,sky,amber,orange,stone' | split: ','
-%}

{%- paginate collection.products by section.settings.products_per_page -%}
  <div class="brissa-collection-grid">
    {%- if collection.products.size == 0 -%}
      <p class="brissa-collection-grid__empty">{{ 'sections.collection_template.empty' | t }}</p>
    {%- else -%}
      <div class="brissa-collection-grid__list">
        {%- for product in collection.products -%}
          {%- liquid
            assign card_desc = product.description | strip_html | truncate: 60
          -%}
          <article class="brissa-collection-card reveal-base">
            <a href="{{ product.url }}" class="brissa-collection-card__link">
              <div class="brissa-collection-card__image">
                {%- if product.featured_image != blank -%}
                  {{
                    product.featured_image
                    | image_url: width: 800
                    | image_tag:
                      loading: 'lazy',
                      widths: '300,450,600,800',
                      sizes: '(min-width: 990px) 25vw, 50vw',
                      alt: product.featured_image.alt | default: product.title | escape
                  }}
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'brissa-collection-card__placeholder' }}
                {%- endif -%}
              </div>
              <div class="brissa-collection-card__body">
                <h2 class="brissa-collection-card__title">{{ product.title }}</h2>
                {%- if card_desc != blank -%}
                  <p class="brissa-collection-card__desc">{{ card_desc }}</p>
                {%- endif -%}
                {%- if product.tags.size > 0 -%}
                  <div class="brissa-collection-card__tags">
                    {%- for tag in product.tags limit: 2 -%}
                      {%- assign color_index = product.id | plus: forloop.index0 | modulo: 5 -%}
                      {%- assign tag_color = tag_colors[color_index] | default: 'stone' -%}
                      <span class="brissa-collection-card__tag brissa-collection-card__tag--{{ tag_color }}">{{ tag }}</span>
                    {%- endfor -%}
                  </div>
                {%- endif -%}
                <div class="brissa-collection-card__price">{{ product.price | money }}</div>
              </div>
            </a>
          </article>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        {%- render 'pagination', paginate: paginate -%}
      {%- endif -%}
    {%- endif -%}
  </div>
{%- endpaginate -%}

{% schema %}
{
  "name": "Brissa collection grid",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 36,
      "step": 4,
      "default": 16,
      "label": "Products per page"
    }
  ]
}
{% endschema %}
