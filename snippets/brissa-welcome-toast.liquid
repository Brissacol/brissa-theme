{%- comment -%} brissa toast: welcome + order tracking {%- endcomment -%}
{{ 'component-brissa-welcome-toast.css' | asset_url | stylesheet_tag }}

<brissa-welcome-toast
  class="brissa-welcome-toast"
  role="status"
  aria-live="polite"
  hidden
  data-logged-in="{% if customer %}true{% else %}false{% endif %}"
  data-cart-count="{{ cart.item_count }}"
  {%- if customer -%}
    data-welcome-message="{{ 'brissa.welcome.message' | t: name: customer.first_name | escape_once }}"
    data-order-message="{{ 'brissa.order_placed.message' | t: name: customer.first_name | escape_once }}"
  {%- else -%}
    data-order-guest-message="{{ 'brissa.order_placed.guest_message_html' | t: login_url: routes.storefront_login_url | escape_once }}"
  {%- endif -%}
>
  <span class="material-symbols-outlined" aria-hidden="true">check_circle</span>
  <span data-toast-text></span>
</brissa-welcome-toast>

{% javascript %}
  document.addEventListener(
    'click',
    (event) => {
      const target = event.target.closest('[name="checkout"]');
      if (!target) return;
      try {
        sessionStorage.setItem('brissaCheckoutClicked', '1');
      } catch (error) {
        /* noop */
      }
    },
    true
  );

  class BrissaWelcomeToast extends HTMLElement {
    connectedCallback() {
      const isLoggedIn = this.dataset.loggedIn === 'true';
      const cartCount = parseInt(this.dataset.cartCount, 10) || 0;
      let wasLoggedIn = false;

      try {
        wasLoggedIn = sessionStorage.getItem('brissaAuthState') === 'in';
        sessionStorage.setItem('brissaAuthState', isLoggedIn ? 'in' : 'out');
      } catch (error) {
        return;
      }

      let justOrdered = false;
      try {
        const checkoutClicked = sessionStorage.getItem('brissaCheckoutClicked') === '1';
        if (checkoutClicked && cartCount === 0) {
          justOrdered = true;
        } else if (checkoutClicked && cartCount > 0) {
          // Came back with items still in the cart: checkout was abandoned, not completed.
          sessionStorage.removeItem('brissaCheckoutClicked');
        }
      } catch (error) {
        justOrdered = false;
      }

      const textEl = this.querySelector('[data-toast-text]');

      if (justOrdered && !isLoggedIn && this.dataset.orderGuestMessage) {
        textEl.innerHTML = this.dataset.orderGuestMessage;
        this.consumeCheckoutClicked();
        this.setPendingOrderThanks();
        this.show(8000);
        return;
      }

      if (!isLoggedIn) return;

      const justLoggedIn = !wasLoggedIn;
      const pendingOrderThanks = justLoggedIn && this.consumePendingOrderThanks();
      if (!justOrdered && !justLoggedIn) return;

      if (justOrdered || pendingOrderThanks) {
        textEl.textContent = this.dataset.orderMessage;
        this.consumeCheckoutClicked();
      } else if (justLoggedIn) {
        textEl.textContent = this.dataset.welcomeMessage;
      } else {
        return;
      }

      this.show(5000);
    }

    consumeCheckoutClicked() {
      try {
        sessionStorage.removeItem('brissaCheckoutClicked');
      } catch (error) {
        /* noop */
      }
    }

    setPendingOrderThanks() {
      try {
        sessionStorage.setItem('brissaPendingOrderThanks', '1');
      } catch (error) {
        /* noop */
      }
    }

    consumePendingOrderThanks() {
      try {
        const pending = sessionStorage.getItem('brissaPendingOrderThanks') === '1';
        sessionStorage.removeItem('brissaPendingOrderThanks');
        return pending;
      } catch (error) {
        return false;
      }
    }

    show(duration) {
      this.hidden = false;
      requestAnimationFrame(() => this.classList.add('is-visible'));
      this.autoCloseTimeout = setTimeout(() => this.close(), duration);
    }

    close() {
      this.classList.remove('is-visible');
      clearTimeout(this.autoCloseTimeout);
      setTimeout(() => {
        this.hidden = true;
      }, 300);
    }
  }

  customElements.define('brissa-welcome-toast', BrissaWelcomeToast);
{% endjavascript %}
